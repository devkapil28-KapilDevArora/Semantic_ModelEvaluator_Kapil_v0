<Window x:Class="SemanticModelEvaluator.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:charts="clr-namespace:SemanticModelEvaluator.App.Controls"
 xmlns:vm="clr-namespace:SemanticModelEvaluator.App.ViewModels"
 Title="{Binding Title}" Width="1460" Height="940" MinWidth="1000" MinHeight="700"
 AutomationProperties.AutomationId="WorkbenchWindow">
 <Window.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
 </Window.InputBindings>
 <DockPanel Margin="16">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Semantic_ModelEvaluator_Kapil_V0" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="MODEL EVALUATION WORKBENCH | local-first | explicit judgments" Foreground="{DynamicResource MutedBrush}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding Idle}">
    <Button Content="_Open" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="OpenWorkspace"/>
    <Button Content="_Save" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveWorkspace"/>
    <Button Content="Light / dark" Command="{Binding ThemeCommand}" AutomationProperties.AutomationId="ThemeToggle"/>
   </StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,10,0,0">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="_Cancel operation" Command="{Binding CancelCommand}" IsEnabled="{Binding Busy}" AutomationProperties.AutomationId="CancelEvaluation"/>
    <StackPanel>
     <TextBlock Text="{Binding NetworkStatus}" FontWeight="SemiBold"/>
     <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OperationStatus"/></ScrollViewer>
     <ProgressBar Height="3" IsIndeterminate="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl SelectedIndex="{Binding TabIndex}" TabStripPlacement="Left" IsEnabled="{Binding Idle}" AutomationProperties.AutomationId="MainNavigation">
   <TabItem Header="00  Compare two models" x:Name="PairTab" AutomationProperties.AutomationId="PairTab">
    <TabItem.Resources>
     <DataTemplate x:Key="SideTemplate">
      <Border BorderBrush="{Binding Color}" BorderThickness="0,5,0,1" Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="4">
       <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Step 1 · Choose source" FontWeight="SemiBold" Margin="0,8,0,2"/>
        <ComboBox ItemsSource="{x:Static vm:PairSideViewModel.SourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Source}"
                  AutomationProperties.Name="{Binding Title, StringFormat='{}{0} source'}"/>
        <TextBlock Text="{Binding SourceExplanation}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="Step 2 · Choose model" FontWeight="SemiBold" Margin="0,10,0,2"/>
        <StackPanel Visibility="{Binding IsProviderSource, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="Provider"/>
         <ComboBox ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Provider}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} provider'}"/>
         <TextBlock Text="{Binding Connection}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="Connection status"/>
         <DockPanel Visibility="{Binding IsHuggingFace, Converter={StaticResource BoolVisibility}}">
          <Button DockPanel.Dock="Right" Content="Search hub..." Command="{Binding SearchCommand}"/>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hugging Face search text"/>
         </DockPanel>
         <TextBlock Text="Model, deployment or revision"/>
         <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Model}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} model'}"/>
         <WrapPanel>
          <Button Content="Validate" Command="{Binding ValidateCommand}"/>
          <Button Content="Download / prepare..." Command="{Binding PrepareCommand}"/>
         </WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsFolderSource, Converter={StaticResource BoolVisibility}}">
         <Button Content="Add complete EvalKit run-output folder..." Command="{Binding BrowseFolderCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsCloudSource, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="Experiment (leave empty to list experiments)"/>
         <TextBox Text="{Binding Experiment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="EvalKit experiment"/>
         <CheckBox Content="Sensitive results container (only if you are authorized; no fallback)" IsChecked="{Binding Sensitive}"/>
         <Button Content="List experiments / jobs..." Command="{Binding ListJobsCommand}" HorizontalAlignment="Left"/>
         <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Job}" AutomationProperties.Name="EvalKit cloud job"/>
         <Button Content="Download and verify this one bundle" Command="{Binding FetchJobCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsBundleSource, Converter={StaticResource BoolVisibility}}">
         <DockPanel>
          <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshBundlesCommand}"/>
          <ComboBox ItemsSource="{Binding Bundles}" SelectedItem="{Binding Bundle}" AutomationProperties.Name="Cached EvalKit bundle"/>
         </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsSavedSource, Converter={StaticResource BoolVisibility}}">
         <Button Content="Open saved run JSON..." Command="{Binding OpenSavedRunCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsCapturedSource, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="Captured run"/>
         <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Run}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} captured run'}"/>
         <Button Content="Validate run" Command="{Binding ValidateCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <TextBlock Text="{Binding ModelDetail}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
     </DataTemplate>
     <DataTemplate x:Key="ThresholdTemplate">
      <Border BorderBrush="{Binding Color}" BorderThickness="3,0,0,0" Padding="8,2" Margin="4">
       <StackPanel>
        <CheckBox IsChecked="{Binding UseThreshold}" Content="{Binding Title, StringFormat='{}{0}: apply score threshold'}"/>
        <DockPanel>
         <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding ThresholdText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} exact threshold'}"/>
         <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Threshold, Mode=TwoWay}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} threshold'}"/>
        </DockPanel>
        <TextBlock Text="{Binding ScoreRangeText}" Foreground="{DynamicResource MutedBrush}"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </TabItem.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="18" IsEnabled="{Binding NotBusy}">
      <DockPanel>
       <WrapPanel DockPanel.Dock="Right">
        <Button Content="Load synthetic demo" Command="{Binding DemoCommand}" AutomationProperties.AutomationId="PairDemo"/>
        <Button Content="Provider settings..." Click="ProviderSettings"/>
       </WrapPanel>
       <StackPanel>
        <TextBlock Text="Compare two models" Style="{StaticResource Heading}"/>
        <TextBlock Text="1 Choose source → 2 Choose two models → 3 Choose dataset → 4 Settings → 5 Run or load and review → 6 Download detailed HTML" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
       </StackPanel>
      </DockPanel>
      <GroupBox Header="Steps 1–2 · Source and models (any cross-provider pair)">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <ContentControl Content="{Binding A}" ContentTemplate="{StaticResource SideTemplate}" Focusable="False"/>
         <ContentControl Grid.Column="1" Content="{Binding B}" ContentTemplate="{StaticResource SideTemplate}" Focusable="False"/>
        </Grid>
        <TextBlock Text="{Binding PairValidation}" TextWrapping="Wrap" Margin="4,6" AutomationProperties.AutomationId="PairValidation" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="Step 3 · Dataset and evaluation">
       <StackPanel>
        <WrapPanel>
         <Button Content="Open dataset manifest..." Command="{Binding OpenDatasetCommand}" AutomationProperties.AutomationId="PairOpenDataset"/>
         <Button Content="Use exact cached EvalKit dataset" Command="{Binding FindCachedDatasetCommand}"/>
         <ComboBox ItemsSource="{Binding DatasetStores}" SelectedItem="{Binding DatasetStore}" MinWidth="260" Margin="8,0,4,0" AutomationProperties.Name="Dataset container (published or working, sensitivity)" ToolTip="Published or working (staging) dataset container to fetch from. Azure enforces your access; no other container is tried."/>
         <Button Content="Fetch exact dataset (EvalKit CLI)..." Command="{Binding FetchDatasetCommand}"/>
        </WrapPanel>
        <TextBlock Text="{Binding DatasetInfo}" TextWrapping="Wrap" Margin="4,8" AutomationProperties.AutomationId="PairDatasetInfo"/>
        <TextBlock Text="{Binding DatasetMatch}" TextWrapping="Wrap" Margin="4,0,4,8" FontWeight="SemiBold" AutomationProperties.AutomationId="PairDatasetMatch"/>
        <Expander Header="Comparison eligibility rules">
         <ItemsControl ItemsSource="{Binding EligibilityRules}" Margin="8,4"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Expander>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="Step 4 · Evaluation settings">
       <StackPanel>
        <WrapPanel>
         <TextBlock Text="K (results per query)" VerticalAlignment="Center"/><TextBox Text="{Binding K, ValidatesOnExceptions=True}" Width="60" AutomationProperties.Name="K"/>
         <TextBlock Text="Sample limit (0 = all items)" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox Text="{Binding SampleLimit, ValidatesOnExceptions=True}" Width="70" AutomationProperties.Name="Sample limit"/>
         <CheckBox Content="Reuse this session's results for an unchanged configuration (no re-invocation)" IsChecked="{Binding ReuseExisting}" Margin="12,0,0,0"/>
        </WrapPanel>
        <TextBlock Text="Evaluation objective (included in the report)"/>
        <TextBox Text="{Binding Objective}" TextWrapping="Wrap" AutomationProperties.Name="Evaluation objective"/>
        <WrapPanel Margin="0,6,0,0">
         <TextBlock Text="Evaluation dimensions:" VerticalAlignment="Center"/>
         <CheckBox Content="Quality" IsChecked="{Binding IncludeQuality}" Margin="8,0,0,0"/>
         <CheckBox Content="Safety / harm" IsChecked="{Binding IncludeHarm}" Margin="8,0,0,0"/>
         <CheckBox Content="Coverage (empty results, score distribution)" IsChecked="{Binding IncludeCoverage}" Margin="8,0,0,0"/>
         <TextBlock Text="Inclusion rule:" VerticalAlignment="Center" Margin="16,0,0,0"/>
         <CheckBox Content="Judged items only (exclude unjudged; they are never treated as passing)" IsChecked="{Binding JudgedItemsOnly}" Margin="8,0,0,0"/>
        </WrapPanel>
        <TextBlock Text="Model parameters (dimensions, API version, prefixes, pooling) come from each model's configuration or manifest and are shown read-only in step 2; edit the Foundry deployment settings or model manifest to change them." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        <Grid Margin="0,6">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <ContentControl Content="{Binding A}" ContentTemplate="{StaticResource ThresholdTemplate}" Focusable="False"/>
         <ContentControl Grid.Column="1" Content="{Binding B}" ContentTemplate="{StaticResource ThresholdTemplate}" Focusable="False"/>
        </Grid>
        <TextBlock Text="{Binding ModePlan}" TextWrapping="Wrap" Background="{DynamicResource BackgroundBrush}" Padding="8" AutomationProperties.AutomationId="PairModePlan"/>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="Step 5 · Run or load comparison, then review">
       <StackPanel>
        <WrapPanel>
         <Button Content="Run or load comparison" Command="{Binding RunCommand}" AutomationProperties.AutomationId="PairRun"/>
         <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        </WrapPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="4,6" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="PairStatus"/>
        <ProgressBar Height="3" IsIndeterminate="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="PairResults">
         <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,10,4,4" AutomationProperties.AutomationId="PairHeadline"/>
         <TextBlock Text="{Binding Blocking}" Foreground="#C42B1C" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,2"/>
         <TextBlock Text="{Binding Warnings}" Foreground="#8A5A00" TextWrapping="Wrap" Margin="4,2"/>
         <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4,6"/>
         <TabControl Margin="0,8" MinHeight="420">
          <TabItem Header="Metrics (side by side)">
           <DataGrid ItemsSource="{Binding MetricRows}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="PairMetrics" MaxHeight="520">
            <DataGrid.Columns>
             <DataGridTextColumn Header="Metric" Binding="{Binding Name}"/>
             <DataGridTextColumn Header="Category" Binding="{Binding Category}"/>
             <DataGridTextColumn Header="Model A" Binding="{Binding A}"/>
             <DataGridTextColumn Header="Model B" Binding="{Binding B}"/>
             <DataGridTextColumn Header="A − B" Binding="{Binding Delta}"/>
             <DataGridTextColumn Header="Better" Binding="{Binding Better}"/>
             <DataGridTemplateColumn Header="0–1 scale (A over B)">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
               <StackPanel Visibility="{Binding HasBars, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding Name}">
                <Rectangle Height="7" Width="{Binding BarA}" Fill="#0072B2" HorizontalAlignment="Left"/>
                <Rectangle Height="7" Width="{Binding BarB}" Fill="#D55E00" HorizontalAlignment="Left" Margin="0,2,0,0"/>
               </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
             </DataGridTemplateColumn>
             <DataGridTextColumn Header="Direction (actual values shown)" Binding="{Binding Direction}"/>
             <DataGridTextColumn Header="Notes" Binding="{Binding Note}"/>
            </DataGrid.Columns>
           </DataGrid>
          </TabItem>
          <TabItem Header="Difference heatmap">
           <StackPanel>
            <TextBlock Text="Cell = A − B. Colour intensity scales with the size of the difference; ▲ A better, ▼ B better, ● tie, ? missing. Hover for exact values." TextWrapping="Wrap" Margin="4"/>
            <ItemsControl ItemsSource="{Binding Heatmap}">
             <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
             <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{Binding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="210" Padding="8" Margin="3" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
               <StackPanel><TextBlock Text="{Binding Metric}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Text}" FontFamily="Consolas"/></StackPanel>
              </Border>
             </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </TabItem>
          <TabItem Header="Threshold curves">
           <StackPanel>
            <WrapPanel>
             <TextBlock Text="Metric" VerticalAlignment="Center"/>
             <ComboBox ItemsSource="{Binding CurveMetrics}" SelectedItem="{Binding CurveMetric}" Width="220" AutomationProperties.Name="Curve metric"/>
            </WrapPanel>
            <TextBlock Text="Each model is swept over its own score range. Click a chart or use ←/→ to move that model's threshold; metrics recalculate from captured scores." TextWrapping="Wrap" Margin="4"/>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <charts:AnalysisChart Series="{Binding CurvesA}" Threshold="{Binding A.Threshold, Mode=TwoWay}" Interactive="True" Height="260" Margin="4" AutomationProperties.Name="Model A threshold curve"/>
             <charts:AnalysisChart Grid.Column="1" Series="{Binding CurvesB}" Threshold="{Binding B.Threshold, Mode=TwoWay}" Interactive="True" Height="260" Margin="4" AutomationProperties.Name="Model B threshold curve"/>
            </Grid>
           </StackPanel>
          </TabItem>
          <TabItem Header="Radar">
           <StackPanel>
            <TextBlock Text="{Binding RadarNote}" TextWrapping="Wrap" Margin="4"/>
            <charts:AnalysisChart Radar="{Binding Radar}" Height="340" AutomationProperties.Name="Quality radar chart"/>
           </StackPanel>
          </TabItem>
          <TabItem Header="Counts, failures, latency, usage">
           <StackPanel>
            <DataGrid ItemsSource="{Binding Counts}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="PairCounts">
             <DataGrid.Columns>
              <DataGridTextColumn Header="Count" Binding="{Binding Name}"/><DataGridTextColumn Header="Model A" Binding="{Binding A}"/><DataGridTextColumn Header="Model B" Binding="{Binding B}"/>
             </DataGrid.Columns>
            </DataGrid>
            <DataGrid ItemsSource="{Binding PerformanceRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
             <DataGrid.Columns>
              <DataGridTextColumn Header="Performance / usage" Binding="{Binding Name}"/><DataGridTextColumn Header="Model A" Binding="{Binding A}"/>
              <DataGridTextColumn Header="Model B" Binding="{Binding B}"/><DataGridTextColumn Header="A − B" Binding="{Binding Delta}"/><DataGridTextColumn Header="Basis" Binding="{Binding Basis}"/>
             </DataGrid.Columns>
            </DataGrid>
           </StackPanel>
          </TabItem>
          <TabItem Header="Queries / samples">
           <DockPanel>
            <WrapPanel DockPanel.Dock="Top">
             <TextBlock Text="Show" VerticalAlignment="Center"/>
             <ComboBox ItemsSource="{x:Static vm:PairComparisonViewModel.RowFilters}" SelectedItem="{Binding RowFilter}" Width="170" AutomationProperties.AutomationId="PairRowFilter"/>
             <TextBlock Text="{Binding RowCountText}" VerticalAlignment="Center" Margin="8,0"/>
            </WrapPanel>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
             <DataGrid ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="460" AutomationProperties.AutomationId="PairRows">
              <DataGrid.Columns>
               <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
               <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}"/>
               <DataGridTextColumn Header="Flags" Binding="{Binding FlagsText}"/>
               <DataGridTextColumn Header="A state" Binding="{Binding A.State}"/>
               <DataGridTextColumn Header="A quality" Binding="{Binding A.Quality, StringFormat=0.000, TargetNullValue=unknown}"/>
               <DataGridTextColumn Header="B state" Binding="{Binding B.State}"/>
               <DataGridTextColumn Header="B quality" Binding="{Binding B.Quality, StringFormat=0.000, TargetNullValue=unknown}"/>
               <DataGridTextColumn Header="A − B" Binding="{Binding Delta, StringFormat=+0.000;-0.000;0.000, TargetNullValue=unknown}"/>
               <DataGridTextColumn Header="Text" Binding="{Binding Text}" MaxWidth="320"/>
              </DataGrid.Columns>
             </DataGrid>
             <StackPanel Grid.Column="1" Margin="8,0">
              <Image Source="{Binding SelectedRow.ImagePath, Converter={StaticResource LocalThumbnail}}" MaxHeight="160" HorizontalAlignment="Left" AutomationProperties.Name="Selected query image (local files only)"/>
              <TextBlock Text="{Binding RowDetail}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" AutomationProperties.AutomationId="PairRowDetail"/>
             </StackPanel>
            </Grid>
           </DockPanel>
          </TabItem>
          <TabItem Header="Strengths and limitations">
           <StackPanel>
            <TextBlock Text="{Binding Strengths}" TextWrapping="Wrap" Margin="4"/>
            <TextBlock Text="Limitations and missing data" FontWeight="SemiBold" Margin="4,10,4,2"/>
            <TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" Margin="4"/>
           </StackPanel>
          </TabItem>
         </TabControl>
        </StackPanel>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="Step 6 · Download detailed HTML">
       <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="A single self-contained .html file (no CDN, no external links, no secrets) with all 21 assessment sections. By default query text, labels and images are excluded; for sensitive or unclassified data the report is aggregate-only (no item IDs or per-item scores)."/>
        <CheckBox Content="Include sample-level content (query text, labels, thumbnails). Sensitive or unclassified data requires confirmation." IsChecked="{Binding IncludeSampleContent}" AutomationProperties.AutomationId="PairIncludeContent"/>
        <Button Content="Download detailed HTML..." Command="{Binding DownloadCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="PairDownload"/>
       </StackPanel>
      </GroupBox>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="01  Model Hub">
    <DockPanel Margin="18">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Model Hub" Style="{StaticResource Heading}"/>
      <TextBlock Text="Select any number of compatible models. Unsupported architectures require imported predictions. No dataset content is sent during discovery."/>
      <WrapPanel Margin="0,8">
       <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="260" AutomationProperties.Name="Hugging Face model search"/>
       <Button Content="Search Hugging Face..." Command="{Binding SearchCommand}"/>
       <Button Content="Refresh local / cached" Command="{Binding RefreshCommand}"/>
       <Button Content="Register ONNX folder..." Command="{Binding RegisterCommand}"/>
       <Button Content="Import predictions..." Command="{Binding ImportCommand}" AutomationProperties.AutomationId="ImportPredictions"/>
       <Button Content="Validate selected" Command="{Binding ValidateCommand}"/>
       <Button Content="Download selected..." Command="{Binding DownloadCommand}"/>
       <Button Content="Provider settings..." Click="ProviderSettings"/>
      </WrapPanel>
     </StackPanel>
     <ListBox ItemsSource="{Binding Models}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ModelSelection">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
        <DockPanel>
         <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,4,12,0"/>
         <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Identity}" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas"/>
          <TextBlock Text="{Binding Details}" Margin="0,6,0,0"/>
         </StackPanel>
        </DockPanel>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </TabItem>
   <TabItem Header="02  Dataset Studio">
    <DockPanel Margin="18">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Dataset Studio" Style="{StaticResource Heading}"/>
      <WrapPanel>
       <Button Content="Open dataset manifest..." Command="{Binding DatasetCommand}" AutomationProperties.AutomationId="OpenDataset"/>
       <Button Content="Map CSV / JSON / JSONL..." Command="{Binding MappingCommand}" AutomationProperties.AutomationId="MapDataset"/>
       <Button Content="Load synthetic demo" Command="{Binding SampleCommand}" AutomationProperties.AutomationId="LoadDemo"/>
      </WrapPanel>
      <TextBlock Text="{Binding DatasetSummary}" Margin="4,12" AutomationProperties.AutomationId="DatasetSummary"/>
     </StackPanel>
     <DataGrid ItemsSource="{Binding Items}" AutomationProperties.AutomationId="DatasetPreview"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="03  Run Evaluation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="18">
      <TextBlock Text="Evaluation Runner" Style="{StaticResource Heading}"/>
      <TextBlock Text="Review all seven steps before starting. CPU only in V0; native text embeddings or local prediction imports. Model downloads are separate, explicit actions."/>
      <GroupBox Header="1. Selected models"><TextBlock Text="{Binding ModelSummary}"/></GroupBox>
      <GroupBox Header="2. Dataset and version / 3. Task"><TextBlock Text="{Binding DatasetSummary}"/></GroupBox>
      <GroupBox Header="4. Compatible metrics">
       <ItemsControl ItemsSource="{Binding Metrics}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <CheckBox IsChecked="{Binding Selected}" Content="{Binding Definition.Name}" ToolTip="{Binding Definition.Explanation}"/>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </GroupBox>
      <GroupBox Header="5. Execution configuration">
       <StackPanel>
        <WrapPanel>
         <TextBlock Text="K" VerticalAlignment="Center"/><TextBox Text="{Binding K, ValidatesOnExceptions=True}" Width="65" AutomationProperties.Name="Top K"/>
         <TextBlock Text="Batch size" VerticalAlignment="Center"/><TextBox Text="{Binding BatchSize, ValidatesOnExceptions=True}" Width="65"/>
         <TextBlock Text="Concurrency" VerticalAlignment="Center"/><TextBox Text="{Binding Concurrency, ValidatesOnExceptions=True}" Width="65"/>
         <TextBlock Text="Timeout (seconds/model)" VerticalAlignment="Center"/><TextBox Text="{Binding TimeoutSeconds, ValidatesOnExceptions=True}" Width="85"/>
         <CheckBox Content="Use embedding cache" IsChecked="{Binding UseCache}"/>
        </WrapPanel>
        <TextBlock Text="Output directory (completed model results are checkpointed here)"/>
        <TextBox Text="{Binding OutputDirectory}" AutomationProperties.Name="Run output directory"/>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="6. Compatibility and privacy review">
       <StackPanel>
        <TextBlock Text="{Binding Compatibility}"/>
        <TextBlock Margin="0,8,0,0" Text="Dataset text is processed locally. External worker bindings execute trusted, installed software. Workspaces may contain generated outputs and analyst notes; treat them according to your dataset classification. Cache-enabled throughput includes cache lookup and is not pure inference throughput."/>
       </StackPanel>
      </GroupBox>
      <Button Content="7. Run selected evaluations" Command="{Binding RunCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RunEvaluation"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="04  Explorer">
    <Grid Margin="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="200" MinWidth="130"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="230" MinWidth="0"/></Grid.ColumnDefinitions>
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="Runs / scenarios" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="Search examples" Margin="0,15,0,0"/>
       <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter examples"/>
      </StackPanel>
      <ListBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" DisplayMemberPath="Name" AutomationProperties.AutomationId="ScenarioSelection"/>
     </DockPanel>
     <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
     <Grid Grid.Column="2" Margin="8,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="Threshold Explorer" Style="{StaticResource Heading}"/>
       <TextBlock Text="Cached-score analysis only: changing a threshold never reruns inference."/>
       <WrapPanel>
        <CheckBox Content="Apply threshold" IsChecked="{Binding UseThreshold}" AutomationProperties.AutomationId="EnableThreshold"/>
        <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" AutomationProperties.AutomationId="ThresholdValue"/>
        <Button Content="Reset" Command="{Binding ResetThresholdCommand}"/>
        <TextBlock Text="K" VerticalAlignment="Center"/><TextBox Text="{Binding K, ValidatesOnExceptions=True}" Width="60"/>
        <Button Content="Details" Command="{Binding ToggleContextCommand}"/>
       </WrapPanel>
       <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Threshold}" IsEnabled="{Binding UseThreshold}" Margin="5,8" AutomationProperties.AutomationId="ThresholdSlider" AutomationProperties.Name="Minimum retained score"/>
       <WrapPanel><TextBox Text="{Binding ScenarioName}" Width="200" AutomationProperties.Name="New scenario name"/><Button Content="Save as scenario" Command="{Binding SaveScenarioCommand}" AutomationProperties.AutomationId="SaveScenario"/></WrapPanel>
       <TextBlock Text="{Binding Summary}" Margin="0,8" AutomationProperties.AutomationId="LiveMetrics"/>
      </StackPanel>
      <WrapPanel Grid.Row="1">
       <TextBlock Text="Curve metric" VerticalAlignment="Center"/>
       <ComboBox ItemsSource="{Binding CurveMetrics}" SelectedItem="{Binding CurveMetric}" AutomationProperties.AutomationId="CurveMetric"/>
      </WrapPanel>
      <charts:AnalysisChart Grid.Row="2" Series="{Binding Curves}" Threshold="{Binding Threshold, Mode=TwoWay}" Interactive="{Binding UseThreshold}" AutomationProperties.AutomationId="ThresholdCurves" AutomationProperties.Name="Threshold curves; hover for values, click or use left and right keys to choose a threshold"/>
      <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"/>
      <TabControl Grid.Row="4">
       <TabItem Header="Metrics"><DataGrid ItemsSource="{Binding MetricGrid}" AutomationProperties.AutomationId="ExplorerMetrics"/></TabItem>
       <TabItem Header="Inspect examples">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Input" AutomationProperties.AutomationId="ExampleSelection"/>
         <DockPanel Grid.Row="1">
          <Image DockPanel.Dock="Right" Source="{Binding SelectedItem.ImagePath, Converter={StaticResource LocalThumbnail}}" Width="80" Height="65" Stretch="Uniform" AutomationProperties.Name="Selected example image"/>
          <TextBlock Text="{Binding SelectedItem.GroundTruth}" Margin="5"/>
         </DockPanel>
         <DataGrid Grid.Row="2" ItemsSource="{Binding Inspector}" AutomationProperties.AutomationId="SideBySideResults"/>
        </Grid>
       </TabItem>
      </TabControl>
     </Grid>
     <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
     <ScrollViewer Grid.Column="4" Visibility="{Binding ContextVisible, Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8">
       <TextBlock Text="Context &amp; definitions" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="Scenario notes" Margin="0,10,0,0"/>
       <TextBox Text="{Binding ScenarioNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" AutomationProperties.Name="Scenario notes"/>
       <TextBlock Text="{Binding DatasetSummary}" Margin="0,12"/>
       <TextBlock Text="{Binding Definitions}"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="05  Comparator">
    <DockPanel Margin="18">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Model Comparator" Style="{StaticResource Heading}"/>
      <WrapPanel><TextBlock Text="Reference scenario" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Reference}" DisplayMemberPath="Name" MinWidth="320" AutomationProperties.AutomationId="ReferenceScenario"/></WrapPanel>
      <TextBlock Text="Delta = scenario - reference. Direction and missing-data policy determine interpretation; no universal best-model score." Margin="0,8"/>
     </StackPanel>
     <TabControl SelectedIndex="{Binding ComparisonTab}" AutomationProperties.AutomationId="ComparisonViews">
      <TabItem Header="Metric grid"><DataGrid ItemsSource="{Binding MetricGrid}" AutomationProperties.AutomationId="ComparisonGrid"/></TabItem>
      <TabItem Header="Heatmap">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Heatmap}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border Background="{Binding Color}" Width="220" Padding="12" Margin="4" CornerRadius="5">
           <StackPanel><TextBlock Foreground="White" Text="{Binding Scenario}"/><TextBlock Foreground="White" Text="{Binding Metric}"/><TextBlock Foreground="White" Text="{Binding Value}" FontSize="22"/><TextBlock Foreground="White" Text="{Binding Delta}"/></StackPanel>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Radar">
       <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Fixed 0-1 metrics only. Lower-is-better metrics use 1-value; no normalization across models. Missing values break the polygon." Margin="8"/>
        <charts:AnalysisChart Radar="{Binding Radar}" AutomationProperties.AutomationId="RadarChart" AutomationProperties.Name="Bounded metric radar; raw values available in metric grid"/>
       </DockPanel>
      </TabItem>
      <TabItem Header="Curves"><charts:AnalysisChart Series="{Binding Curves}" Threshold="{Binding Threshold}" AutomationProperties.Name="Multi-model threshold curves"/></TabItem>
      <TabItem Header="Distributions"><charts:AnalysisChart Series="{Binding Histograms}" AutomationProperties.AutomationId="ScoreDistributions" AutomationProperties.Name="Score distributions; x score, y count"/></TabItem>
      <TabItem Header="Errors"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Errors}" Margin="12"/></ScrollViewer></TabItem>
      <TabItem Header="Performance"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Performance}" Margin="12"/></ScrollViewer></TabItem>
      <TabItem Header="Ranking">
       <DockPanel>
        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding RankingPolicies}" SelectedItem="{Binding RankingPolicy}" DisplayMemberPath="Name"/>
        <StackPanel>
         <TextBlock Text="Weights (metric_id=value, separated by commas). Nonnegative weights only; missing metrics exclude a scenario." Margin="8"/>
         <TextBox Text="{Binding RankingWeights}" AutomationProperties.Name="Custom ranking weights"/>
         <Button Content="Apply custom weights" Command="{Binding ApplyRankingCommand}" HorizontalAlignment="Left"/>
         <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450"><TextBlock Text="{Binding Ranking}" Margin="12"/></ScrollViewer>
        </StackPanel>
       </DockPanel>
      </TabItem>
     </TabControl>
    </DockPanel>
   </TabItem>
   <TabItem Header="06  Workbook / Export">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
     <TextBlock Text="Workbooks &amp; reports" Style="{StaticResource Heading}"/>
     <WrapPanel>
      <Button Content="Save" Command="{Binding SaveCommand}"/><Button Content="Save as..." Command="{Binding SaveAsCommand}"/>
      <Button Content="Open..." Command="{Binding OpenCommand}"/><Button Content="Duplicate" Command="{Binding DuplicateCommand}"/>
     </WrapPanel>
     <TextBlock Text="Analyst notes" Margin="0,16,0,4"/>
     <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="170" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AnalystNotes"/>
     <TextBlock Text="Workbooks retain exact identities, cached predictions, scenarios and thresholds. Original dataset files remain external and are checked by hash on restore. Generated output and notes may be sensitive." Margin="0,12"/>
     <GroupBox Header="Export comparison">
      <StackPanel>
       <WrapPanel><ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding ExportFormat}"/><Button Content="Export..." Command="{Binding ExportCommand}" AutomationProperties.AutomationId="ExportComparison"/></WrapPanel>
       <CheckBox Content="Include example text and outputs (requires confirmation)" IsChecked="{Binding IncludeExamples}"/>
      </StackPanel>
     </GroupBox>
     <GroupBox Header="Network &amp; runtime">
      <StackPanel>
       <TextBlock Text="{Binding NetworkStatus}"/>
       <Button Content="Toggle offline mode" Command="{Binding OfflineCommand}" HorizontalAlignment="Left"/>
       <Button Content="Credentials / worker bindings..." Click="ProviderSettings" HorizontalAlignment="Left"/>
       <Button Content="Clear embedding cache..." Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left"/>
       <TextBlock Text="Native execution: compatible BERT WordPiece ONNX text embeddings on CPU. Other model families require imported predictions. Microsoft provider installation and authentication remain external; no internal endpoints or credentials are bundled."/>
      </StackPanel>
     </GroupBox>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
